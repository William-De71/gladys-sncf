                "en": "Under 15 min",
                "fr": "Moins de 15 min"
              }
            },
            {
              "value": "major",
              "label": {
                "en": "15 to 29 min",
                "fr": "15 à 29 min"
              }
            },
            {
              "value": "severe",
              "label": {
