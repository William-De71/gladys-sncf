      "key": "delay_threshold",
      "type": "number",
      "label": {
        "en": "Delay threshold (min)",
        "fr": "Seuil de retard (min)"
      },
      "description": {
        "en": "From how many minutes a train counts as delayed (scenes, disrupted trains, colors).",
        "fr": "À partir de combien de minutes un train compte comme en retard (scènes, trains perturbés, couleurs)."
      },
      "min": 1,
      "max": 30,
      "default": 5,
      "required": false
    },
    {
      "key": "poll_interval",
      "type": "number",
      "label": {
        "en": "Refresh around the window (min)",
        "fr": "Rafraîchissement autour de la plage (min)"
      },
      "description": {
        "en": "From an hour before the travel window to its end (all day without a window), between 2 and 30 minutes.",
        "fr": "D’une heure avant la plage horaire jusqu’à sa fin (toute la journée sans plage), entre 2 et 30 minutes."
      },
      "min": 2,
      "max": 30,
      "default": 3,
      "required": false
    },
