        "fr": "Trains suivis par trajet"
      },
      "description": {
        "en": "The next trains of each trip, between 1 and 8.",
        "fr": "Les prochains trains de chaque trajet, entre 1 et 8."
      },
      "min": 1,
      "max": 8,
      "default": 4,
      "required": false
    },
